{
  "lsp": {
    "eslint": {
      "settings": {
        "workingDirectory": { "mode": "location" }
      }
    }
  },
  "languages": {
    "TypeScript": {
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.eslint": false
      },
      "formatter": "prettier"
    },
    "TSX": {
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.eslint": false
      },
      "formatter": "prettier"
    }
  }
}
